# Telegram order delivery. Never commit real values.
TELEGRAM_BOT_TOKEN=123456:replace_with_real_bot_token
# For public channel/group username you can start with @lookberrys if the bot is allowed there.
# For private groups/supergroups use the numeric chat id, for example -1001234567890.
TELEGRAM_CHAT_ID=@lookberrys

# Optional order/admin settings
DELIVERY_FEE_UZS=15000
ADMIN_PASSWORD=change-this-password
